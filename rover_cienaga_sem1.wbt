      translation -0.4 0 3.2
      children [
        Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 } geometry Box { size 0.35 0.35 1.1 } }
        Transform {
          translation -0.18 0 0.3 rotation 0 1 0 1.5708
          children [ DEF LUZ_ROJA Shape { appearance DEF MAT_ROJO PBRAppearance { baseColor 0.8 0.05 0.05 emissiveColor 1.0 0.0 0.0 } geometry Cylinder { height 0.05 radius 0.1 } } ]
        }
        Transform {
          translation -0.18 0 0.0 rotation 0 1 0 1.5708
          children [ DEF LUZ_AMARILLA Shape { appearance DEF MAT_AMARILLO PBRAppearance { baseColor 0.3 0.25 0.02 emissiveColor 0.0 0.0 0.0 } geometry Cylinder { height 0.05 radius 0.1 } } ]
        }
        Transform {
          translation -0.18 0 -0.3 rotation 0 1 0 1.5708
          children [ DEF LUZ_VERDE Shape { appearance DEF MAT_VERDE PBRAppearance { baseColor 0.02 0.3 0.05 emissiveColor 0.0 0.0 0.0 } geometry Cylinder { height 0.05 radius 0.1 } } ]
